{
  "expo": {
    "name": "Blanquita Choferes",
    "slug": "blanquita-mobile",
    "scheme": "blanquita-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#20A7DB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blanquita.choferes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Blanquita Choferes necesita acceder a tu ubicación GPS para validar las visitas a clientes y registrar las entregas en campo.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Blanquita Choferes necesita geolocalización continua durante la jornada de despacho para telemetría en vivo de la flota."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#20A7DB"
      },
      "package": "com.blanquita.choferes",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite que la app capture la ubicación GPS al registrar entregas y cobros."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3001330e-9f98-41cf-bff8-bbd5c4840c4c"
      }
    }
  }
}
